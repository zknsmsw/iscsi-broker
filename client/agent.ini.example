; ============================================================
;  客户机 agent 配置（放到 iscsi-broker-agent.exe 同目录，文件名必须是 agent.ini）
;  母盘里做一次即可（Admin 回写模式启动客户机后配置，之后所有机器共用）
; ============================================================

[server]
; 服务器地址（Web 后台端口，不是 iPXE 的 5000）
url=http://10.1.1.1:8080
; 接入令牌：服务器后台「客户机控制」页上那一串（点一下可复制）
token=
; 心跳间隔（秒）。指令随心跳下发，3 秒足够，网络差可调大
interval=3
; 可选：强制指定本机 MAC（12 位十六进制，不带分隔符）。
; 一般留空由程序自动取“默认网关网卡”的 MAC；多网卡/测试机才需要写
mac=

[vnc]
; VNC 服务端的可执行文件全路径（母盘里先装好 VNC 服务端）。
; 留空 = 后台点“启用 VNC”会报“未配置”。推荐 TightVNC/UltraVNC 的“服务模式”，
; 服务模式能看到登录界面；只写 exe 时是以 SYSTEM 进程方式拉起，看的是当前桌面。
exe=
; 启动参数（按你装的 VNC 服务端填），例如 TightVNC 服务模式：-run
args=
; 可选：VNC 服务端注册的 Windows 服务名（填了就用 net start/stop 控制，
; 比直接拉起 exe 更稳，也能看登录界面）。例如 tvnserver / uvnc_service
service=
; VNC 服务端监听的端口（只用于后台展示）
port=5900

[dav]
; 网盘映射的盘符（不带冒号）
letter=Z
